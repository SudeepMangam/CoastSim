# Server runs without credentials for public NOAA and Open-Meteo data.
# Optional: path to a local NOAA/CARICOOS/Copernicus DEM GeoTIFF in meters.
# DEM_PATH=/absolute/path/to/san_juan_bathymetry.tif

# Optional: CF NetCDF hydrodynamic grid with time/depth/lat/lon and u/v.
# OCEAN_NETCDF_PATH=/absolute/path/to/ocean_3d.nc
# OCEAN_U_VAR=uo
# OCEAN_V_VAR=vo
# OCEAN_W_VAR=wo
# OCEAN_TIME_VAR=time
# OCEAN_DEPTH_VAR=depth
# OCEAN_LAT_VAR=latitude
# OCEAN_LON_VAR=longitude

# Optional Copernicus account is obtained at https://data.marine.copernicus.eu/
# Credentials are NOT consumed automatically by this app. Download a spatially
# subsetted NetCDF through Copernicus Marine Toolbox and set OCEAN_NETCDF_PATH.
# Do not commit secrets to source control.

# Create .env.local beside package.json, never commit the token.
# Cesium ion Access Tokens: https://ion.cesium.com/tokens
# Use a public, assets:read, URL-restricted token. Do not use private write scopes.
VITE_CESIUM_ION_TOKEN=
